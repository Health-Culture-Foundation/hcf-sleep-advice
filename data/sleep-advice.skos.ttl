  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/insomnia> ;
  skos:editorialNote "Paradoxical intention and acceptance-based approaches."@en .

<https://health-culture.org/sleep-advice/calm-music-at-bedtime> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Listening to calm music for 25 to 60 minutes at bedtime may help you sleep better."@en ;
  hsa:kind "advice" ;
  skos:broader <https://health-culture.org/sleep-advice/category/3.3> ;
  skos:related <https://health-culture.org/sleep-advice/binaural-beats> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
