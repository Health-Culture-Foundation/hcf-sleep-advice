  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/any-time> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:editorialNote "Polyphasic sleep (NSF 2021 consensus)."@en .

<https://health-culture.org/sleep-advice/later-school-start-times> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Teens' body clocks run later; support later school start times instead of blaming teens for sleeping late."@en ;
  hsa:kind "advice" ;
  skos:broader <https://health-culture.org/sleep-advice/category/1.1> ;
  skos:related <https://health-culture.org/sleep-advice/fit-bedtime-to-your-body-clock> ;
