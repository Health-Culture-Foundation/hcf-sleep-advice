<https://health-culture.org/sleep-advice/4-7-8-breathing> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "To wind down, breathe in for 4, hold for 7, and breathe out for 8."@en ;
  hsa:kind "advice" ;
  skos:notation "2.4.1" ;
  skos:altLabel "Practice the 4-7-8 breathing technique before bed"@en ;
  skos:altLabel "4-7-8 Breathing"@en ;
  skos:broader <https://health-culture.org/sleep-advice/relaxation-techniques> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
