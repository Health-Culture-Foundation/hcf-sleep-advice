  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/insomnia> ;
  skos:definition "Create a 30-minute wind-down routine before bed with calming activities like reading, light stretching, or listening to soft music. Stick to the same routine nightly to reinforce your body's sleep signals."@en ;
  skos:editorialNote "Write-up has no citations."@en .

<https://health-culture.org/sleep-advice/skip-exciting-things-before-bed> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Save exciting or stressful activities for earlier in the evening."@en ;
  hsa:kind "advice" ;
  skos:notation "1.3.3" ;
  skos:altLabel "Reduce stimulating activities close to bedtime"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/1.3> ;
