  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/bedtime> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:editorialNote "Listed with no write-up."@en .

<https://health-culture.org/sleep-advice/kiwi-or-tart-cherries> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Some small studies found kiwi or tart cherry before bed helped sleep."@en ;
  hsa:kind "advice" ;
  skos:notation "2.5.1" ;
  skos:altLabel "Consume kiwi or tart cherries before bed"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/2.5> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/substances> ;
