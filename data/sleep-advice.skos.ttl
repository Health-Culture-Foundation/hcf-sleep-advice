  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/on-waking> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:editorialNote "Policy-level advice."@en .

<https://health-culture.org/sleep-advice/infant-safe-sleep> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Put babies to sleep on their backs, on a firm flat surface, in your room but not in your bed."@en ;
  hsa:kind "advice" ;
  skos:altLabel "Safe sleep for babies"@en ;
  skos:altLabel "SIDS prevention"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/1.2> ;
