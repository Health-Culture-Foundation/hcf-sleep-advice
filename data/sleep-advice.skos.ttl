  skos:broader <https://health-culture.org/sleep-advice/calm-your-mind-before-bed> ;
  hsa:conflictsWith <https://health-culture.org/sleep-advice/write-down-worries> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/evening> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/irregular-schedules> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/circadian-cues> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/stress> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/relationships> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/money-worries> ;
  skos:definition "Each night, write down three things you’re grateful for and why—this shifts focus away from stress and promotes relaxation before bed."@en ;
  skos:editorialNote "Wiki item says 'instead of a to-do list', which conflicts with 3.1.4 (write down worries and next steps). Write-up has no citations."@en .

<https://health-culture.org/sleep-advice/binaural-beats> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Some people relax with binaural beats; evidence for sleep is mixed."@en ;
  hsa:kind "advice" ;
  skos:notation "3.3.3" ;
  skos:altLabel "Listen to binaural beats at a sleep-friendly frequency (e.g., 2-8 Hz)"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/3.3> ;
  skos:related <https://health-culture.org/sleep-advice/calm-music-at-bedtime> ;
  skos:related <https://health-culture.org/sleep-advice/mask-noise-with-steady-sound> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/sleep-environment> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/bedtime> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:definition "Try delta wave binaural beats (2-4 Hz) for deep sleep by listening through stereo headphones at low volume before bed."@en ;
  skos:editorialNote "Needs headphones. Wiki rates it 3 on red flags (mixed) on the item page. Write-up has no citations."@en .

<https://health-culture.org/sleep-advice/nature-sounds-or-asmr> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Try nature sounds or ASMR recordings to relax at bedtime."@en ;
  hsa:kind "advice" ;
  skos:notation "3.3.4" ;
  skos:altLabel "Listen to nature sounds or ASMR for relaxation"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/3.3> ;
  skos:related <https://health-culture.org/sleep-advice/mask-noise-with-steady-sound> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/sleep-environment> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/bedtime> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:editorialNote "In the wiki's 'New Sleep Advices' list. No write-up."@en .

<https://health-culture.org/sleep-advice/left-side-for-reflux> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "If you get heartburn at night, try sleeping on your left side."@en ;
  hsa:kind "advice" ;
  skos:notation "4.1.1" ;
  skos:altLabel "Sleep on your left side to aid digestion and reduce acid reflux"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/4.1> ;
  skos:related <https://health-culture.org/sleep-advice/raise-the-head-of-the-bed> ;
  skos:related <https://health-culture.org/sleep-advice/side-sleeping-for-snoring> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/digestion-and-fluids> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/body-position> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/during-the-night> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/reflux> ;
  skos:definition "If you experience acid reflux at night, try placing a wedge pillow under your upper body while sleeping on your left side for added relief."@en ;
  skos:editorialNote "Wiki summary table rates evidence 5/5; write-up cites nothing. Pregnancy advice about left-side sleeping is a separate topic, not covered."@en .

<https://health-culture.org/sleep-advice/acupressure-or-massage> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Some people relax with gentle massage or acupressure before sleep."@en ;
  hsa:kind "advice" ;
  skos:notation "4.1.2" ;
  skos:altLabel "Try acupressure or gentle massage before sleep"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/4.1> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/bedtime> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:definition "Try gently massaging the pericardium-6 point (three finger-widths below your wrist crease) in circular motions for one to two minutes before bed to promote relaxation."@en ;
  skos:editorialNote "Write-up has no citations."@en .

<https://health-culture.org/sleep-advice/raise-the-head-of-the-bed> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "If you have reflux or sleep apnea, raising your upper body may help; ask your clinician."@en ;
  hsa:kind "advice" ;
  skos:notation "4.1.3" ;
  skos:altLabel "Try an inclined sleeping position if you have sleep apnea or acid reflux"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/4.1> ;
  skos:related <https://health-culture.org/sleep-advice/check-for-sleep-apnea> ;
  skos:related <https://health-culture.org/sleep-advice/left-side-for-reflux> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/digestion-and-fluids> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/breathing-and-airway> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/body-position> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/during-the-night> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/reflux> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/sleep-apnea> ;
  skos:definition "For best results, elevate your upper body by 6-8 inches using a wedge pillow or an adjustable bed instead of stacking pillows, which can strain the neck."@en ;
  skos:editorialNote "Wiki classification tables rate it 1 on everything (hardest, weakest); the item page rates it well supported with strong impact. Biggest internal spread in the wiki."@en .

<https://health-culture.org/sleep-advice/raise-your-legs> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Some people find raising their legs a little helps them feel comfortable at night."@en ;
  hsa:kind "advice" ;
  skos:notation "4.1.4" ;
  skos:altLabel "Elevate your legs slightly to improve circulation"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/4.1> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/sleep-environment> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/body-position> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/bedtime> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:editorialNote "In the wiki's 'New Sleep Advices' list. No write-up or evidence; the circulation claim in the wiki title is not repeated."@en .

<https://health-culture.org/sleep-advice/keep-a-sleep-diary> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Write down when you go to bed, wake up and how you slept for a week or two."@en ;
  hsa:kind "advice" ;
  skos:notation "4.2.1" ;
  skos:altLabel "Keep a sleep diary to track patterns and identify issues"@en ;
  skos:altLabel "Sleep log"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/4.2> ;
  skos:related <https://health-culture.org/sleep-advice/cbt-for-insomnia> ;
  skos:related <https://health-culture.org/sleep-advice/sleep-restriction-therapy> ;
  skos:related <https://health-culture.org/sleep-advice/use-sleep-trackers-lightly> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/slp-sleep-restriction-therapy/> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/slp-cognitive-behavioral-therapy-for-insomnia/> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/monitoring-and-care> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/on-waking> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/insomnia> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/substances-and-diet> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/cannabis-use> ;
  skos:definition "Use a notebook or sleep-tracking app to record your bedtime, wake time, sleep interruptions, and factors like caffeine intake or stress levels for at least two weeks to spot trends."@en ;
  skos:editorialNote "A sleep diary is the starting point for sleep restriction therapy and CBT-I. Write-up has no citations."@en .

<https://health-culture.org/sleep-advice/light-therapy-for-a-late-body-clock> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "If you can't fall asleep until very late, ask a clinician about timed melatonin or morning light."@en ;
  hsa:kind "advice" ;
  skos:notation "4.2.2" ;
  skos:altLabel "Consider light therapy if you have delayed sleep phase disorder (DSPD)"@en ;
  skos:altLabel "Bright light therapy"@en ;
  skos:altLabel "Light box"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/4.2> ;
  skos:related <https://health-culture.org/sleep-advice/get-morning-daylight> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/sleep-disorders-circadian-rhythm/> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/body-clock> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/on-waking> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/late-body-clock> ;
  skos:definition "If you struggle with falling asleep late and waking up late, use a 10,000-lux light box for 30 minutes within an hour of waking up to help regulate your circadian rhythm."@en ;
  skos:editorialNote "Wiki tip names a 10,000-lux box. Write-up has no citations. Plain line corrected after the literature search: AASM 2015 makes no recommendation for light therapy alone in adults with delayed sleep-wake phase, but weakly recommends timed melatonin."@en .

<https://health-culture.org/sleep-advice/melatonin-for-jet-lag-or-shifts> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Melatonin may help with jet lag or shift work; ask a pharmacist or doctor first."@en ;
  hsa:kind "advice" ;
  skos:notation "4.2.3" ;
  skos:altLabel "Consider a melatonin supplement if struggling with jet lag or shift work"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/4.2> ;
  skos:related <https://health-culture.org/sleep-advice/adjust-to-night-shift-work> ;
  skos:related <https://health-culture.org/sleep-advice/jet-lag> ;
  skos:related <https://health-culture.org/sleep-advice/melatonin-for-children> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/slp-coping-with-jet-lag/> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/slp-adjusting-to-night-shift-work/> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/jet-lag-syndrome/> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/body-clock> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/substances> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/ahead-of-time> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/evening> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/jet-lag> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/shift-work> ;
  skos:editorialNote "In the wiki's 'New Sleep Advices' list. No write-up."@en .

<https://health-culture.org/sleep-advice/check-for-sleep-apnea> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "If you snore loudly or gasp in your sleep, ask a doctor about sleep apnea."@en ;
  hsa:kind "advice" ;
  skos:notation "4.2.4" ;
  skos:altLabel "Check for potential sleep apnea"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/4.2> ;
  skos:related <https://health-culture.org/sleep-advice/bed-partner-snoring> ;
  skos:related <https://health-culture.org/sleep-advice/get-help-if-poor-sleep-persists> ;
  skos:related <https://health-culture.org/sleep-advice/mouth-taping> ;
  skos:related <https://health-culture.org/sleep-advice/myth-snoring-is-harmless> ;
  skos:related <https://health-culture.org/sleep-advice/raise-the-head-of-the-bed> ;
  skos:related <https://health-culture.org/sleep-advice/side-sleeping-for-snoring> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/sleep-wake-disorders/> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/monitoring-and-care> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/breathing-and-airway> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/any-time> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/sleep-apnea> ;
  skos:editorialNote "In the wiki's 'New Sleep Advices' list. No write-up; myth M5 (snoring) covers it with citations. The glossary has 'Sleep Apnea, Central' but no obstructive sleep apnea term yet."@en .

<https://health-culture.org/sleep-advice/check-your-medicines> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Ask your pharmacist or doctor whether any of your medicines can affect sleep."@en ;
  hsa:kind "advice" ;
  skos:altLabel "Review Medicines That Disrupt Sleep"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/4.2> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/slp-review-medicines-that-disrupt-sleep/> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/monitoring-and-care> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/substances> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/any-time> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/insomnia> ;
  skos:definition "Some heart, blood pressure, and asthma medicines, along with some over-the-counter cough, cold, and allergy remedies, can interfere with sleep. If you're having trouble sleeping, ask your doctor or pharmacist whether something you're taking could be the cause, and whether it can be taken earlier in the day instead."@en .

<https://health-culture.org/sleep-advice/cbt-for-insomnia> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "For long-lasting insomnia, ask about CBT-I, a structured talking and habits treatment."@en ;
  hsa:kind "advice" ;
  skos:altLabel "Cognitive Behavioral Therapy for Insomnia"@en ;
  skos:altLabel "CBT-I"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/4.2> ;
  skos:related <https://health-culture.org/sleep-advice/get-help-if-poor-sleep-persists> ;
  skos:related <https://health-culture.org/sleep-advice/keep-a-sleep-diary> ;
  skos:related <https://health-culture.org/sleep-advice/tips-alone-dont-fix-insomnia> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/slp-cognitive-behavioral-therapy-for-insomnia/> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/learned-association> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/sleep-pressure> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/any-time> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/insomnia> ;
  skos:definition "A structured treatment for chronic insomnia that combines behavior changes — like reconditioning and sleep restriction therapy — with replacing unhelpful thoughts about sleep, such as \"I'll never fall asleep without pills,\" with more realistic ones. It's effective for most people with chronic insomnia."@en ;
  skos:editorialNote "The wiki's discussion tab names CBT-I as the intervention linking categories 3 and 4, but it has no item."@en .

<https://health-culture.org/sleep-advice/sleep-restriction-therapy> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "With a clinician's help, limit time in bed to the sleep you actually get, then add time back."@en ;
  hsa:kind "advice" ;
  skos:altLabel "Sleep Restriction Therapy"@en ;
  skos:broader <https://health-culture.org/sleep-advice/cbt-for-insomnia> ;
  skos:related <https://health-culture.org/sleep-advice/keep-a-sleep-diary> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/slp-sleep-restriction-therapy/> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/sleep-pressure> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/any-time> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/insomnia> ;
  skos:definition "A technique for insomnia that limits time in bed to match how much you actually sleep. Calculate your average sleep time over a week, keep your time in bed to that amount, then gradually add more as your sleep improves. Naps longer than 15-20 minutes are avoided during this process, since they can undo the effect."@en ;
  skos:editorialNote "NHLBI caution: avoid driving or machinery while sleep-deprived during this process."@en .

<https://health-culture.org/sleep-advice/jet-lag> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Before a long trip, shift your sleep times a little toward the new time zone."@en ;
  hsa:kind "advice" ;
  skos:altLabel "Coping With Jet Lag"@en ;
  skos:broader <https://health-culture.org/sleep-advice/change-sleep-times-gradually> ;
  skos:related <https://health-culture.org/sleep-advice/body-temperature-low-point> ;
  skos:related <https://health-culture.org/sleep-advice/melatonin-for-jet-lag-or-shifts> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/slp-coping-with-jet-lag/> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/body-clock> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/ahead-of-time> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/jet-lag> ;
  skos:definition "A handful of adjustments that can ease jet lag on a trip of more than a few days: shift your sleep and wake times by small steps for a couple of days beforehand, get plenty of outdoor daylight right after you arrive, skip alcohol and afternoon caffeine, and keep any naps short (10-15 minutes)."@en .

<https://health-culture.org/sleep-advice/adjust-to-night-shift-work> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "On night shifts, use bright light at work and a dark, quiet room to sleep in."@en ;
  hsa:kind "advice" ;
  skos:altLabel "Adjusting to Night Shift Work"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/1.1> ;
  skos:related <https://health-culture.org/sleep-advice/melatonin-for-jet-lag-or-shifts> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/slp-adjusting-to-night-shift-work/> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/body-clock> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/sleep-environment> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/any-time> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/shift-work> ;
  skos:definition "Ways to make night-shift sleep easier: add naps and extra sleep time, use bright light at work, keep shift changes infrequent so your body clock has time to adjust, block out light and noise while sleeping during the day, and limit caffeine to the start of the shift."@en .

<https://health-culture.org/sleep-advice/late-afternoon-daylight> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Some advise getting outside in late-afternoon light too."@en ;
  hsa:kind "advice" ;
  skos:altLabel "Late-Afternoon Sunlight Viewing"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/2.1> ;
  skos:related <https://health-culture.org/sleep-advice/get-morning-daylight> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/body-clock> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/afternoon> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:definition "Spend a little time outdoors in the late afternoon or early evening, when the sun is low, looking toward the sky (never straight at the sun). It is meant to signal to your body clock that evening is coming."@en ;
  skos:editorialNote "Huberman only; low confidence in the glossary. His protective claim is unverified and left out."@en .

<https://health-culture.org/sleep-advice/body-temperature-low-point> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Your body is coldest a couple of hours before you usually wake."@en ;
  hsa:kind "concept" ;
  skos:altLabel "Temperature Minimum"@en ;
  skos:altLabel "Core body temperature minimum"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/2.1> ;
  skos:related <https://health-culture.org/sleep-advice/jet-lag> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/body-clock> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/body-temperature> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/during-the-night> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/jet-lag> ;
  skos:definition "The coldest point of your body's daily temperature cycle. In this model it falls about 2 hours before you usually wake up, so about 5 a.m. if you wake at 7. Bright light, exercise, or caffeine in the 2 to 4 hours before it nudges your body clock later; the same things in the hours just after it nudge your clock earlier. Some people use the timing to shift their clock before travel."@en ;
  skos:editorialNote "A concept used in jet-lag advice, not advice by itself. The 2-hour figure is Huberman's and unverified."@en .

<https://health-culture.org/sleep-advice/box-breathing> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Breathe in for 4, hold for 4, out for 4, hold for 4, and repeat."@en ;
  hsa:kind "advice" ;
  skos:altLabel "Box Breathing"@en ;
  skos:broader <https://health-culture.org/sleep-advice/relaxation-techniques> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/bedtime> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/during-the-night> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/anxiety> ;
  skos:definition "A counted breathing pattern: breathe in for 4, hold for 4, breathe out for 4, hold for 4, then repeat. Picturing the numbers as you count gives your mind something to focus on. Beginners can start with 4 to 5 rounds."@en .

<https://health-culture.org/sleep-advice/cyclic-sighing> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Breathe in fully through your nose, then breathe out slowly and completely."@en ;
  hsa:kind "advice" ;
  skos:altLabel "Cyclic Sighing"@en ;
  skos:broader <https://health-culture.org/sleep-advice/relaxation-techniques> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/bedtime> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/during-the-night> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/anxiety> ;
  skos:definition "A breathing pattern for calming down fast: breathe in through the nose until your lungs feel full, then, without holding, let the air out slowly and completely. A few rounds is often enough to quiet racing thoughts."@en .

<https://health-culture.org/sleep-advice/belly-breathing> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Breathe slowly so your belly, not your chest, rises and falls."@en ;
  hsa:kind "advice" ;
  skos:altLabel "Belly Breathing"@en ;
  skos:broader <https://health-culture.org/sleep-advice/relaxation-techniques> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/bedtime> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/anxiety> ;
  skos:definition "Breathing deeply so your belly rises as you breathe in and falls as you breathe out, slowly and through the nose. It is the base skill for most other relaxation breathing exercises."@en .

<https://health-culture.org/sleep-advice/alternate-nostril-breathing> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Breathe in through one nostril and out the other, switching sides."@en ;
  hsa:kind "advice" ;
  skos:altLabel "Alternate Nostril Breathing"@en ;
  skos:altLabel "Nadi shodhana"@en ;
  skos:broader <https://health-culture.org/sleep-advice/nose-breathing-exercises> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/bedtime> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:definition "A breathing exercise where you close one nostril with a finger, breathe in through the other, then switch sides for the breath out and the next breath in. Beginners can try 5 to 10 rounds. It is used to settle strong emotions."@en .

<https://health-culture.org/sleep-advice/rest-even-if-awake> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Lying still with your eyes closed rests you a little, but it is not a substitute for sleep."@en ;
  hsa:kind "advice" ;
  skos:altLabel "Non-Sleep Deep Rest"@en ;
  skos:altLabel "NSDR"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/3.1> ;
  skos:related <https://health-culture.org/sleep-advice/stop-trying-to-sleep> ;
  hsa:conflictsWith <https://health-culture.org/sleep-advice/get-up-if-you-cant-sleep> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/during-the-night> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/insomnia> ;
  skos:definition "Lying still in the dark and quiet, awake, with your eyes closed. It is not sleep, but it can still rest the body, which can take pressure off the effort to fall asleep."@en ;
  skos:editorialNote "Pulls against 3.2.3 (get up after 20 minutes). Plain line corrected 2026-10-21 after the literature search: sleep experts rate 'lying in bed with eyes closed is almost as good as sleeping' a myth (Robbins 2019), and no study shows quiet wakefulness is restorative."@en .

<https://health-culture.org/sleep-advice/power-down-hour> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Use the last hour before bed for chores, then washing up, then something calm."@en ;
  hsa:kind "advice" ;
  skos:altLabel "Power-Down Hour"@en ;
  skos:altLabel "Wind-down hour"@en ;
  skos:broader <https://health-culture.org/sleep-advice/have-a-wind-down-routine> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/learned-association> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/evening> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:definition "A set hour before bed split into three 20-minute parts: one for chores and last-minute tasks, one for hygiene such as brushing teeth, washing your face, or a warm shower, and one for something slow and calming such as reading, meditation, or prayer. Setting an alarm an hour before bedtime reminds you to start."@en .

<https://health-culture.org/sleep-advice/3-2-1-rule> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Stop alcohol 3 hours, food 2 hours and drinks 1 hour before bed."@en ;
  hsa:kind "advice" ;
  skos:altLabel "3-2-1 Rule"@en ;
  skos:broader <https://health-culture.org/sleep-advice/caffeine-and-big-meals-early> ;
  skos:related <https://health-culture.org/sleep-advice/drink-more-earlier-in-the-day> ;
  skos:related <https://health-culture.org/sleep-advice/no-alcohol-close-to-bedtime> ;
  hsa:conflictsWith <https://health-culture.org/sleep-advice/herbal-tea-before-bed> ;
  hsa:conflictsWith <https://health-culture.org/sleep-advice/small-snack-before-bed> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/substances> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/digestion-and-fluids> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/evening> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:definition "A countdown before bed: stop alcohol 3 hours before, stop eating 2 hours before, and stop drinking fluids 1 hour before. People who need fluids for medicine, diabetes, or constant thirst should skip the fluid cutoff and ask their doctor."@en .

<https://health-culture.org/sleep-advice/frozen-water-bottle> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "On hot nights, a frozen water bottle wrapped in a sock can cool you down in bed."@en ;
  hsa:kind "advice" ;
  skos:altLabel "Cool Down With a Frozen Water Bottle"@en ;
  skos:broader <https://health-culture.org/sleep-advice/keep-the-bedroom-cool-and-dark> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/body-temperature> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/bedtime> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:definition "A low-tech way to cool your body before sleep: freeze a bottle of water, put it in a sock, and place one by each hip in bed."@en ;
  skos:editorialNote "A personal trick; no evidence cited."@en .

<https://health-culture.org/sleep-advice/delay-first-coffee> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Some advise waiting 90 minutes or more after waking for your first coffee."@en ;
  hsa:kind "advice" ;
  skos:altLabel "Delay Your First Coffee"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/2.2> ;
  skos:related <https://health-culture.org/sleep-advice/caffeine-cutoff> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/substances> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/on-waking> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:definition "Drink water first and wait about 90 minutes after waking before your first cup of coffee."@en ;
  skos:editorialNote "Popular claim; evidence not checked."@en .

<https://health-culture.org/sleep-advice/caffeine-cutoff> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Pick a time in the early afternoon after which you have no caffeine."@en ;
  hsa:kind "advice" ;
  skos:altLabel "Set a Caffeine Cutoff"@en ;
  skos:broader <https://health-culture.org/sleep-advice/caffeine-and-big-meals-early> ;
  skos:related <https://health-culture.org/sleep-advice/delay-first-coffee> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/substances> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/afternoon> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/substances-and-diet> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/caffeine-timing> ;
  skos:definition "Pick a time in the early afternoon after which you stop caffeine, so it has worn off by bedtime. Caffeine can stay in your body for many hours."@en ;
  skos:editorialNote "Specific version of 2.2.1; see its caffeine disagreement."@en .

<https://health-culture.org/sleep-advice/fit-bedtime-to-your-body-clock> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "If you're naturally a night owl or early bird, set your bedtime with that in mind."@en ;
  hsa:kind "advice" ;
  skos:altLabel "Match Bedtime to Your Chronotype"@en ;
  skos:altLabel "Chronotype"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/1.1> ;
  skos:related <https://health-culture.org/sleep-advice/keep-a-regular-sleep-schedule> ;
  skos:related <https://health-culture.org/sleep-advice/later-school-start-times> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/body-clock> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/evening> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/late-body-clock> ;
  skos:definition "Your chronotype is your natural lean toward mornings or evenings. Going to bed much earlier or later than your body prefers can make falling asleep harder, so set your bedtime with your own pattern in mind."@en ;
  skos:editorialNote "Evidence for tailoring bedtime to chronotype not checked. Breus's branded animal labels left out."@en .

<https://health-culture.org/sleep-advice/stay-in-bed-and-breathe> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "One expert says to stay in bed and breathe slowly when you wake at night."@en ;
  hsa:kind "advice" ;
  skos:altLabel "Stay in Bed and Breathe When You Wake at Night"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/3.2> ;
  hsa:conflictsWith <https://health-culture.org/sleep-advice/get-up-if-you-cant-sleep> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/during-the-night> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/insomnia> ;
  skos:definition "When you wake in the middle of the night, stay in bed with the lights off and use slow breathing to settle, instead of getting up, walking around, or picking up your phone. If you do not need the bathroom, skip the trip. Keep a glass of room-temperature water by the bed."@en ;
  skos:editorialNote "Conflicts with 3.2.3 and NHLBI; kept so the disagreement is visible."@en .

<https://health-culture.org/sleep-advice/dim-the-lights-after-dark> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "After dark, keep indoor lights low and screens dim."@en ;
  hsa:kind "advice" ;
  skos:altLabel "Dim the Lights at Night"@en ;
  hsa:deprecated true ;
  dct:isReplacedBy <https://health-culture.org/sleep-advice/less-bright-light-in-the-evening> ;
  skos:definition "After sunset, keep indoor lighting low. Avoid bright overhead lights, especially from about 10 p.m. to 4 a.m., turn screens down as far as you can still use them, and use only as much light as you need to move around safely."@en ;
  skos:editorialNote "Merged into less-bright-light-in-the-evening: Huberman's 'Dim the Lights at Night' and wiki 2.1.2 give the same advice; his time window is kept as a disagreement detail. Earlier note: Overlaps 2.1.2 and 2.1.4. Huberman's 10 p.m.-4 a.m. window is his rule of thumb."@en .

<https://health-culture.org/sleep-advice/finish-work-earlier> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Stop work or schoolwork at least an hour before bed."@en ;
  hsa:kind "advice" ;
  skos:altLabel "Work & School Deadlines / Work/School Responsibilities"@en ;
  skos:altLabel "Work cutoff"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/3.1> ;
  skos:related <https://health-culture.org/sleep-advice/skip-exciting-things-before-bed> ;
  skos:related <https://health-culture.org/sleep-advice/write-down-worries> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/time-displacement> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/evening> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/anxiety> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/irregular-schedules> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/deadlines> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/stress> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/work-school> ;
  skos:definition "Deadlines push us to sacrifice rest, but the late-night work rarely pays off the next day. Finishing earlier allows the brain to settle and restores clarity for tomorrow."@en ;
  skos:editorialNote "Not in the wiki or glossary. Do One Thing commitments give 9 pm and one hour as examples."@en .

<https://health-culture.org/sleep-advice/plan-social-time-earlier> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Plan get-togethers earlier in the day so late nights are the exception."@en ;
  hsa:kind "advice" ;
  skos:altLabel "Social Commitments"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/1.1> ;
  skos:related <https://health-culture.org/sleep-advice/keep-a-regular-sleep-schedule> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/body-clock> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/time-displacement> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/evening> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/irregular-schedules> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/social-commitments> ;
  skos:definition "Connection is vital, but it doesn’t need to cost tomorrow’s energy. By shifting when and how we socialize, we keep both joy and rest intact."@en .

<https://health-culture.org/sleep-advice/move-in-the-morning> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Stretch or move your body soon after you wake up."@en ;
  hsa:kind "advice" ;
  skos:altLabel "I will stretch or move my body every morning to signal the day has begun."@en ;
  skos:broader <https://health-culture.org/sleep-advice/exercise-regularly> ;
  skos:related <https://health-culture.org/sleep-advice/get-morning-daylight> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/body-clock> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/on-waking> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/irregular-schedules> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/circadian-cues> ;
  skos:editorialNote "Body-clock reasoning ('signal the day has begun') is not cited."@en .

<https://health-culture.org/sleep-advice/use-an-alarm-clock> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Use an alarm clock instead of your phone, so the phone can stay out of the bedroom."@en ;
  hsa:kind "advice" ;
  skos:altLabel "I will use an alarm clock instead of relying on my phone."@en ;
  skos:broader <https://health-culture.org/sleep-advice/keep-devices-out-of-the-bedroom> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/time-displacement> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/any-time> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/technology> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/bedroom-devices> .

<https://health-culture.org/sleep-advice/get-help-if-poor-sleep-persists> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "If poor sleep lasts more than a few weeks, talk with a health professional."@en ;
  hsa:kind "advice" ;
  skos:altLabel "If poor sleep persists for more than a few weeks, talk with a professional — you don’t have to navigate it alone."@en ;
  skos:altLabel "When to see a professional"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/4.2> ;
  skos:related <https://health-culture.org/sleep-advice/cbt-for-insomnia> ;
  skos:related <https://health-culture.org/sleep-advice/check-for-sleep-apnea> ;
  skos:related <https://health-culture.org/sleep-advice/tips-alone-dont-fix-insomnia> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/monitoring-and-care> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/any-time> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/insomnia> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/anxiety> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/stress> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/mental-health> ;
  skos:definition "Anxiety and depression can complicate sleep, but simple practices and self-compassion change the tone of nights."@en ;
  skos:editorialNote "From the homepage quick tips and the Mental Health Conditions commitments."@en .

<https://health-culture.org/sleep-advice/be-kind-to-yourself-after-a-bad-night> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "After a bad night, go easy on yourself; one rough night is feedback, not failure."@en ;
  hsa:kind "advice" ;
  skos:altLabel "I will give myself grace on rough nights. / I will see poor sleep not as failure but as feedback."@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/3.1> ;
  skos:related <https://health-culture.org/sleep-advice/calm-your-mind-before-bed> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/any-time> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/insomnia> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/anxiety> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/stress> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/mental-health> ;
  skos:editorialNote "A mindset item. Worry about sleep itself keeps people awake; that reasoning is not cited here."@en .

<https://health-culture.org/sleep-advice/cannabis-and-sleep> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "If you use cannabis, keep it away from bedtime and notice how it affects your sleep."@en ;
  hsa:kind "advice" ;
  skos:altLabel "Marijuana Use"@en ;
  skos:altLabel "Marijuana and sleep"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/2.2> ;
  skos:related <https://health-culture.org/sleep-advice/no-alcohol-close-to-bedtime> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/substances> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/evening> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/substances-and-diet> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/cannabis-use> ;
  skos:definition "Cannabis affects sleep differently for everyone, but heavy use often suppresses restorative REM cycles. Reflection and moderation bring clarity."@en ;
  skos:editorialNote "The REM claim is Do One Thing's and is not cited. Not in the wiki or glossary."@en .

<https://health-culture.org/sleep-advice/bright-days-dark-nights> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Get plenty of bright light during the day, and keep your nights dark."@en ;
  hsa:kind "advice" ;
  skos:broader <https://health-culture.org/sleep-advice/category/2.1> ;
  skos:related <https://health-culture.org/sleep-advice/get-morning-daylight> ;
