<https://health-culture.org/sleep-advice/cognitive-shuffling> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "If your mind races, picture a string of random, unconnected things."@en ;
  hsa:kind "advice" ;
  skos:notation "3.3.1" ;
  skos:altLabel "Engage in \"cognitive shuffling\""@en ;
  skos:broader <https://health-culture.org/sleep-advice/calm-your-mind-before-bed> ;
