  skos:altLabel "Practice relaxation techniques (e.g., deep breathing, meditation)"@en ;
  skos:altLabel "Relaxation Therapy"@en ;
  skos:broader <https://health-culture.org/sleep-advice/calm-your-mind-before-bed> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/slp-relaxation-therapy/> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/bedtime> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/during-the-night> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/anxiety> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/insomnia> ;
  skos:definition "Try the 4-7-8 breathing technique before bed: inhale for 4 seconds, hold for 7 seconds, and exhale for 8 seconds to promote relaxation and prepare for sleep."@en ;
  skos:editorialNote "Write-up has no citations."@en .

<https://health-culture.org/sleep-advice/progressive-muscle-relaxation> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Tense and then relax each muscle group, one at a time, from feet to head."@en ;
  hsa:kind "advice" ;
  skos:notation "3.1.3" ;
  skos:altLabel "Use progressive muscle relaxation (PMR) before bed"@en ;
  skos:altLabel "Progressive Muscle Relaxation"@en ;
  skos:altLabel "PMR"@en ;
  skos:broader <https://health-culture.org/sleep-advice/relaxation-techniques> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/bedtime> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/anxiety> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/insomnia> ;
  skos:definition "Start with your feet and work your way up, tensing each muscle group for 5-10 seconds, then relaxing for 15-20 seconds to promote full-body relaxation before sleep."@en .

<https://health-culture.org/sleep-advice/write-down-worries> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Write down what's on your mind, and one next step, before bed."@en ;
  hsa:kind "advice" ;
  skos:notation "3.1.4" ;
  skos:altLabel "Write down worries or concerns before bed to clear your mind"@en ;
  skos:altLabel "Worry Journal"@en ;
  skos:altLabel "Scheduled worry time"@en ;
  skos:broader <https://health-culture.org/sleep-advice/calm-your-mind-before-bed> ;
  hsa:conflictsWith <https://health-culture.org/sleep-advice/gratitude-list> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/evening> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/anxiety> ;
  skos:editorialNote "In the wiki's 'New Sleep Advices' list (not yet placed). No write-up."@en .

<https://health-culture.org/sleep-advice/naps-and-night-sleep> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Short naps are fine for most people; long or late naps can make night sleep harder."@en ;
  hsa:kind "advice" ;
  skos:notation "3.2.1" ;
  skos:altLabel "Naps harm nighttime sleep"@en ;
  hsa:deprecated true ;
  dct:isReplacedBy <https://health-culture.org/sleep-advice/keep-naps-short-and-early> ;
  skos:definition "If you nap, keep it under 30 minutes and avoid napping after 3 PM to minimize its impact on nighttime sleep."@en ;
  skos:editorialNote "Merged into keep-naps-short-and-early: Wiki 3.2.1 is the claim behind 1.1.4, and its own tip is the same advice. Earlier note: The wiki item is a claim ('Naps harm nighttime sleep'), not advice, and its own evidence says it depends. Recommend merging into 1.1.4 and moving the claim to the myths list."@en .

<https://health-culture.org/sleep-advice/bed-is-for-sleep> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Use your bed only for sleep and sex."@en ;
  hsa:kind "advice" ;
  skos:notation "3.2.2" ;
  skos:altLabel "Use the bed only for sleep and intimacy"@en ;
  skos:broader <https://health-culture.org/sleep-advice/stimulus-control> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/slp-reconditioning-therapy/> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/learned-association> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/any-time> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/insomnia> ;
  skos:definition "If you can’t sleep after 20 minutes, get out of bed and do a relaxing activity (e.g., reading under dim light) until you feel sleepy, then return to bed."@en ;
  skos:editorialNote "Part of stimulus control (NHLBI calls it reconditioning therapy). Wiki tip folds in 3.2.3."@en .

<https://health-culture.org/sleep-advice/get-up-if-you-cant-sleep> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "If you can't sleep after about 20 minutes, get up and do something calm until you feel sleepy."@en ;
  hsa:kind "advice" ;
  skos:notation "3.2.3" ;
  skos:altLabel "Avoid lying in bed awake for more than 20 minutes—get up and do a calming activity"@en ;
  skos:altLabel "Don't Lie in Bed Awake"@en ;
  skos:altLabel "Reconditioning Therapy"@en ;
  skos:broader <https://health-culture.org/sleep-advice/stimulus-control> ;
  skos:related <https://health-culture.org/sleep-advice/dont-check-the-clock> ;
  hsa:conflictsWith <https://health-culture.org/sleep-advice/stay-in-bed-and-breathe> ;
  hsa:conflictsWith <https://health-culture.org/sleep-advice/rest-even-if-awake> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/slp-don-t-lie-in-bed-awake/> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/slp-reconditioning-therapy/> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/learned-association> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/during-the-night> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/bedtime> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/insomnia> ;
  skos:editorialNote "Direct conflict between sources; the declaration's 'where sources disagree' field exists for cases like this. In the wiki's 'New Sleep Advices' list. No write-up."@en .

<https://health-culture.org/sleep-advice/cognitive-shuffling> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "If your mind races, picture a string of random, unconnected things."@en ;
  hsa:kind "advice" ;
  skos:notation "3.3.1" ;
  skos:altLabel "Engage in \"cognitive shuffling\""@en ;
  skos:broader <https://health-culture.org/sleep-advice/calm-your-mind-before-bed> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/bedtime> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/during-the-night> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:definition "Try mentally listing random objects that aren’t connected (e.g., apple, ladder, river, violin) to disengage from stressful thoughts and ease into sleep."@en ;
  skos:editorialNote "Kept on purpose as niche-but-maybe-valuable (Kalman's v1.2 feedback). Wiki scores clash: classification table rates evidence 1 (weakest), item page rates it well supported, and the scatterplot text promotes it as 'practical but lesser-known'. Write-up has no citations."@en .

<https://health-culture.org/sleep-advice/gratitude-list> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Before bed, write down three things you're thankful for."@en ;
  hsa:kind "advice" ;
  skos:notation "3.3.2" ;
  skos:altLabel "Use a gratitude journal instead of a to-do list"@en ;
  skos:altLabel "Gratitude List Before Bed"@en ;
  skos:broader <https://health-culture.org/sleep-advice/calm-your-mind-before-bed> ;
  hsa:conflictsWith <https://health-culture.org/sleep-advice/write-down-worries> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/evening> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:definition "Each night, write down three things you’re grateful for and why—this shifts focus away from stress and promotes relaxation before bed."@en ;
  skos:editorialNote "Wiki item says 'instead of a to-do list', which conflicts with 3.1.4 (write down worries and next steps). Write-up has no citations."@en .

<https://health-culture.org/sleep-advice/binaural-beats> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Some people relax with binaural beats; evidence for sleep is mixed."@en ;
  hsa:kind "advice" ;
  skos:notation "3.3.3" ;
  skos:altLabel "Listen to binaural beats at a sleep-friendly frequency (e.g., 2-8 Hz)"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/3.3> ;
  skos:related <https://health-culture.org/sleep-advice/mask-noise-with-steady-sound> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/sleep-environment> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/bedtime> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:definition "Try delta wave binaural beats (2-4 Hz) for deep sleep by listening through stereo headphones at low volume before bed."@en ;
  skos:editorialNote "Needs headphones. Wiki rates it 3 on red flags (mixed) on the item page. Write-up has no citations."@en .

