  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/any-time> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> .

<https://health-culture.org/sleep-advice/use-sleep-trackers-lightly> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Use a sleep tracker lightly, if at all; it can't diagnose sleep problems, and if the numbers make you worry, stop."@en ;
  hsa:kind "advice" ;
  skos:broader <https://health-culture.org/sleep-advice/category/4.2> ;
  skos:related <https://health-culture.org/sleep-advice/keep-a-sleep-diary> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/monitoring-and-care> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/any-time> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> .

<https://health-culture.org/sleep-advice/side-sleeping-for-snoring> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "If your snoring or apnea is worse on your back, sleeping on your side may help; ask your clinician."@en ;
  hsa:kind "advice" ;
  skos:broader <https://health-culture.org/sleep-advice/category/4.1> ;
  skos:related <https://health-culture.org/sleep-advice/check-for-sleep-apnea> ;
  skos:related <https://health-culture.org/sleep-advice/left-side-for-reflux> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/breathing-and-airway> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/body-position> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/during-the-night> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/sleep-apnea> .

<https://health-culture.org/sleep-advice/myth-alcohol-helps-sleep> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Alcohol may make you drowsy, but it makes sleep worse later in the night."@en ;
  hsa:kind "myth" ;
  skos:notation "M1" ;
  skos:related <https://health-culture.org/sleep-advice/no-alcohol-close-to-bedtime> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/substances> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/evening> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:definition "While alcohol may induce drowsiness and help you fall asleep faster, it negatively impacts the quality of your rest[77][78]."@en .

<https://health-culture.org/sleep-advice/myth-weekend-catch-up> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Sleeping in on weekends doesn't fully make up for short sleep during the week."@en ;
  hsa:kind "myth" ;
  skos:notation "M2" ;
  skos:related <https://health-culture.org/sleep-advice/dont-sleep-in-much-on-weekends> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/body-clock> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/sleep-pressure> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/on-waking> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:definition "Sleeping in on weekends may provide temporary relief from sleep deprivation, but it does not fully restore the negative effects of lost sleep[82][83]."@en .

<https://health-culture.org/sleep-advice/myth-exercise-right-before-bed> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Regular exercise helps sleep, but hard workouts right before bed can keep you up."@en ;
  hsa:kind "myth" ;
  skos:notation "M3" ;
  skos:related <https://health-culture.org/sleep-advice/no-hard-workouts-right-before-bed> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/body-temperature> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/evening> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:definition "Regular exercise is well known for promoting better sleep by reducing stress, improving mood, and regulating the body's circadian rhythm[17]. However, engaging in intense workouts too close to bedtime can have the opposite effect."@en .

<https://health-culture.org/sleep-advice/myth-tv-helps-you-sleep> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Falling asleep to TV can make sleep lighter and more broken."@en ;
  hsa:kind "myth" ;
  skos:notation "M4" ;
  skos:related <https://health-culture.org/sleep-advice/screens-before-bed> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/light-at-night> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/time-displacement> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/bedtime> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:definition "Many people believe that watching TV before bed helps them unwind and fall asleep, but it can actually do more harm than good[88]."@en ;
  skos:editorialNote "Wiki explains this with blue light; see 1.3.1 for why the light mechanism is disputed."@en .

<https://health-culture.org/sleep-advice/myth-snoring-is-harmless> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Loud, frequent snoring can be a sign of sleep apnea and is worth checking."@en ;
  hsa:kind "myth" ;
  skos:notation "M5" ;
  skos:related <https://health-culture.org/sleep-advice/check-for-sleep-apnea> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/breathing-and-airway> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/during-the-night> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/sleep-apnea> ;
  skos:definition "Occasional snoring is common and may result from factors like nasal congestion, sleep position, or fatigue[89][90]. However, frequent and loud snoring can be a warning sign of obstructive sleep apnea (OSA), a serious sleep disorder in which breathing repeatedly stops and starts during sleep[91]."@en .

<https://health-culture.org/sleep-advice/stimulus-control> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Teach your body that bed means sleep."@en ;
  hsa:kind "group" ;
  skos:altLabel "Stimulus control"@en ;
  skos:altLabel "Stimulus control therapy"@en ;
  skos:altLabel "Reconditioning therapy"@en ;
  skos:broader <https://health-culture.org/sleep-advice/cbt-for-insomnia> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/learned-association> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/bedtime> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/during-the-night> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/insomnia> ;
  skos:editorialNote "Grouping concept added so the two wiki items and the two NHLBI glossary entries for the same technique sit under one name. 'Stimulus control' is the clinical name; NHLBI says 'reconditioning'."@en .

<https://health-culture.org/sleep-advice/commitments> a skos:ConceptScheme ; dct:title "Do One Thing commitments and tips"@en .

<https://health-culture.org/sleep-advice/commitment/dot-irregular-schedules-tip-1> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/commitments> ;
  skos:prefLabel "Aim to keep your bedtime and wake-up time within the same hour every day, even on weekends."@en ;
  hsa:lineType "action" ;
  hsa:appliesTo <https://health-culture.org/sleep-advice/keep-a-regular-sleep-schedule> ;
  hsa:appliesTo <https://health-culture.org/sleep-advice/dont-sleep-in-much-on-weekends> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/irregular-schedules> .
<https://health-culture.org/sleep-advice/commitment/dot-irregular-schedules-tip-2> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/commitments> ;
  skos:prefLabel "If you’re up late, try a short nap the next day instead of sleeping in for hours, which can make the cycle worse."@en ;
  hsa:lineType "action" ;
  hsa:appliesTo <https://health-culture.org/sleep-advice/keep-naps-short-and-early> ;
  hsa:appliesTo <https://health-culture.org/sleep-advice/dont-sleep-in-much-on-weekends> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/irregular-schedules> .
<https://health-culture.org/sleep-advice/commitment/dot-irregular-schedules-tip-3> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/commitments> ;
  skos:prefLabel "Plan social activities earlier when you can — morning coffee catch-ups or evening walks can replace midnight hangouts."@en ;
  hsa:lineType "action" ;
