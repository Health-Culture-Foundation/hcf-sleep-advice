  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/body-clock> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/on-waking> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/late-body-clock> ;
  skos:definition "Spend 10–30 minutes outside in the morning, preferably within an hour of waking. If natural sunlight isn’t available, consider using a bright light therapy lamp for similar benefits."@en ;
  skos:editorialNote "Wiki scores reach 3 on the item page but 5 in the summary table, and novelty 4 vs 1."@en .

<https://health-culture.org/sleep-advice/less-bright-light-in-the-evening> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Use dimmer, warmer lights in the evening."@en ;
  hsa:kind "advice" ;
  skos:notation "2.1.2" ;
  skos:altLabel "Reduce blue light exposure in the evening"@en ;
  skos:altLabel "After dark, keep indoor lights low and screens dim."@en ;
  skos:altLabel "Dim the Lights at Night"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/2.1> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/light-at-night> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/body-clock> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/evening> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/late-body-clock> ;
  skos:definition "Use blue light filter apps on screens, wear blue light-blocking glasses, and switch to warm, dim lighting (like red or amber bulbs) 1–2 hours before bed."@en ;
  skos:editorialNote "Wiki item says 'reduce blue light'. The NSF 2024 consensus did not reach consensus that pre-bedtime screen light impairs sleep; the plain line is about room light overall, not screen filters. Write-up has no citations."@en .

<https://health-culture.org/sleep-advice/use-dim-red-light-at-night> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "If you need light at night, use a dim red or amber one."@en ;
  hsa:kind "advice" ;
  skos:notation "2.1.3" ;
  skos:altLabel "Use dim red light at night instead of blue or white light"@en ;
  skos:altLabel "Use Red Light If You Must Be Up at Night"@en ;
  skos:broader <https://health-culture.org/sleep-advice/less-bright-light-in-the-evening> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/light-at-night> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/during-the-night> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:definition "Use a red night light or replace bedside lamps with dim red bulbs in the evening to minimize sleep disruption."@en ;
  skos:editorialNote "Wiki scores disagree on evidence (item page: well supported; classification table: limited). Huberman's reason (cortisol) is unverified. Write-up has no citations."@en .

