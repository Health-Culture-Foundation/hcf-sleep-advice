  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/sleep-apnea> .

<https://health-culture.org/sleep-advice/be-wary-of-influencer-advice> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Be wary of sleep advice from popular videos and influencers; check it against a health service or sleep society."@en ;
  hsa:kind "advice" ;
  skos:broader <https://health-culture.org/sleep-advice/category/4.2> ;
