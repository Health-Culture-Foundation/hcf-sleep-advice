  skos:definition "Set a regular bedtime and wake-up time, even on weekends. Use alarms or bedtime reminders to help stay consistent, and get morning sunlight to reinforce your body’s natural clock."@en .

<https://health-culture.org/sleep-advice/change-sleep-times-gradually> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "If you need to move your sleep times, shift them a little each day instead of all at once."@en ;
  hsa:kind "advice" ;
  skos:notation "1.1.2" ;
  skos:altLabel "Avoid drastic changes in sleep and wake times"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/1.1> ;
