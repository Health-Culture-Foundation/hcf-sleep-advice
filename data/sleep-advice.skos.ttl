  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> .

<https://health-culture.org/sleep-advice/stop-trying-to-sleep> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "If trying hard to fall asleep keeps you awake, stop trying and let sleep come on its own."@en ;
  hsa:kind "advice" ;
  skos:altLabel "Paradoxical intention"@en ;
  skos:altLabel "Sleep effort"@en ;
  skos:broader <https://health-culture.org/sleep-advice/cbt-for-insomnia> ;
