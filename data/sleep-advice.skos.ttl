<https://health-culture.org/sleep-advice/melatonin-for-children> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Melatonin isn't automatically safe for children and teens just because it's natural; ask a clinician first."@en ;
  hsa:kind "advice" ;
