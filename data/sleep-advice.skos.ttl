  skos:notation "2.2.2" ;
  skos:altLabel "Stay hydrated earlier in the day and gradually reduce water intake"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/2.2> ;
  skos:related <https://health-culture.org/sleep-advice/3-2-1-rule> ;
