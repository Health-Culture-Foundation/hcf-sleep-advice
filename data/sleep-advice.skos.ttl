  skos:notation "1.3.2" ;
  skos:altLabel "Establish a relaxing bedtime routine (e.g., reading, warm bath)"@en ;
  skos:altLabel "Relax Before Bed"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/1.3> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/slp-relax-before-bed/> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/slp-take-a-warm-bath-before-bed/> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
