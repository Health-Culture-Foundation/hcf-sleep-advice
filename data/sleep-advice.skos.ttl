  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/any-time> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/insomnia> .

<https://health-culture.org/sleep-advice/avoid-nicotine-before-bed> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Avoid smoking or vaping in the evening; if you quit, sleep may be rough for a few weeks before it improves."@en ;
  hsa:kind "advice" ;
  skos:broader <https://health-culture.org/sleep-advice/category/2.2> ;
  skos:related <https://health-culture.org/sleep-advice/caffeine-and-big-meals-early> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/substances> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/evening> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:editorialNote "NHLBI pairs nicotine with caffeine (see caffeine-and-big-meals-early)."@en .

<https://health-culture.org/sleep-advice/pets-in-the-bedroom> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "A pet in the bedroom is usually fine; if it wakes you, keep it off the bed."@en ;
  hsa:kind "advice" ;
  skos:broader <https://health-culture.org/sleep-advice/category/1.2> ;
