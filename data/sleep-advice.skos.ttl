  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/daytime> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/insomnia> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/stress> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/get-exercise> ;
  skos:definition "Engage in at least 30 minutes of moderate exercise (e.g., walking, cycling, or strength training) most days, but avoid vigorous workouts right before bed, as they may be too stimulating."@en ;
  skos:editorialNote "NHLBI: at least 30 minutes most days (p. 28)."@en .

<https://health-culture.org/sleep-advice/gentle-stretching-before-bed> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Try a few minutes of gentle stretching or yoga before bed."@en ;
  hsa:kind "advice" ;
  skos:notation "2.3.2" ;
  skos:altLabel "Try relaxing exercises like yoga or stretching before bed"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/2.3> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/bedtime> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:definition "Try 5–10 minutes of gentle stretching or yoga poses, such as child’s pose, forward bend, or deep breathing exercises, to help relax the body before bed."@en ;
  skos:editorialNote "Write-up has no citations."@en .

<https://health-culture.org/sleep-advice/strength-training-earlier-in-the-day> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "If you do strength training, try it in the afternoon or early evening."@en ;
  hsa:kind "advice" ;
  skos:notation "2.3.3" ;
  skos:altLabel "Try resistance training in the afternoon"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/2.3> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/sleep-pressure> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/body-clock> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/afternoon> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:definition "Aim for 30–45 minutes of resistance training in the afternoon or early evening, such as bodyweight exercises, weightlifting, or resistance bands, to maximize deep sleep benefits."@en ;
  skos:editorialNote "Wiki scores disagree (classification table: reach 1, novelty 5; item page: reach 2, novelty 4). Write-up has no citations."@en .

<https://health-culture.org/sleep-advice/no-hard-workouts-right-before-bed> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Finish hard workouts at least an hour before bed; evening exercise is otherwise fine."@en ;
  hsa:kind "advice" ;
  skos:notation "2.3.4" ;
  skos:altLabel "Avoid intense workouts within 2 hours of bedtime"@en ;
  skos:altLabel "Time Your Exercise for Sleep"@en ;
  skos:broader <https://health-culture.org/sleep-advice/skip-exciting-things-before-bed> ;
  skos:related <https://health-culture.org/sleep-advice/exercise-regularly> ;
  skos:related <https://health-culture.org/sleep-advice/myth-exercise-right-before-bed> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/slp-time-your-exercise-for-sleep/> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/body-temperature> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/evening> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:editorialNote "Plain line corrected after the literature search: Stutz 2019 and Frimpong 2021 find evening exercise fine, except vigorous exercise ending within about 1 hour of bed. Experts in Robbins 2019 rated 'exercise within 4 hours disturbs sleep' a myth."@en .

<https://health-culture.org/sleep-advice/4-7-8-breathing> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "To wind down, breathe in for 4, hold for 7, and breathe out for 8."@en ;
  hsa:kind "advice" ;
  skos:notation "2.4.1" ;
  skos:altLabel "Practice the 4-7-8 breathing technique before bed"@en ;
  skos:altLabel "4-7-8 Breathing"@en ;
  skos:broader <https://health-culture.org/sleep-advice/relaxation-techniques> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/bedtime> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/during-the-night> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/anxiety> ;
  skos:definition "Before bed, try four cycles of the 4-7-8 breathing technique while lying down in a comfortable position to help calm the nervous system."@en ;
  skos:editorialNote "Wiki item says it 'can slow heart rate'; the glossary flags Breus's heart-rate claim as unverified. Write-up has no citations."@en .

<https://health-culture.org/sleep-advice/mouth-taping> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Mouth taping is popular, but the evidence is thin; check with a clinician first."@en ;
  hsa:kind "advice" ;
  skos:notation "2.4.2" ;
  skos:altLabel "Sleep with your mouth closed (or use mouth tape if needed)"@en ;
  skos:altLabel "Mouth tape"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/2.4> ;
  skos:related <https://health-culture.org/sleep-advice/check-for-sleep-apnea> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/breathing-and-airway> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/during-the-night> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/sleep-apnea> ;
  skos:definition "If you struggle with mouth breathing, try nasal strips or practice breathing exercises during the day to strengthen nasal breathing habits before considering mouth tape."@en ;
  skos:editorialNote "Wiki rates evidence weak-to-limited and impact low in its classification tables, but well supported on the item page. Safety for people with blocked noses or possible sleep apnea not checked; the plain line is cautious on purpose. The wiki's novelty-vs-reach section calls mouth taping 'strong scientific support but low commonality', which contradicts its own scores."@en .

<https://health-culture.org/sleep-advice/nose-breathing-exercises> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Try slow breathing through your nose before sleep."@en ;
  hsa:kind "advice" ;
  skos:notation "2.4.3" ;
