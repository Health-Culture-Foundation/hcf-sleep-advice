  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/insomnia> ;
  skos:editorialNote "Frames the whole dataset: most items here are sleep hygiene tips, which AASM 2021 advises against as the only treatment for chronic insomnia."@en .

<https://health-culture.org/sleep-advice/dont-split-sleep-into-blocks> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Don't try to split your sleep into several short blocks a day to need less sleep."@en ;
  hsa:kind "advice" ;
  skos:altLabel "Polyphasic sleep"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/1.1> ;
