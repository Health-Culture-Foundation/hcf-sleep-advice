  skos:altLabel "Take a warm shower or bath before bed"@en ;
  skos:altLabel "Take a Warm Bath Before Bed"@en ;
  skos:broader <https://health-culture.org/sleep-advice/have-a-wind-down-routine> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/slp-take-a-warm-bath-before-bed/> ;
