  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/irregular-schedules> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/circadian-cues> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/technology> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/stress> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/mental-health> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/substances-and-diet> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/cannabis-use> ;
  skos:definition "Create a 30-minute wind-down routine before bed with calming activities like reading, light stretching, or listening to soft music. Stick to the same routine nightly to reinforce your body's sleep signals."@en ;
  skos:editorialNote "Write-up has no citations."@en .

<https://health-culture.org/sleep-advice/skip-exciting-things-before-bed> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Save exciting or stressful activities for earlier in the evening."@en ;
  hsa:kind "advice" ;
  skos:notation "1.3.3" ;
  skos:altLabel "Reduce stimulating activities close to bedtime"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/1.3> ;
  skos:related <https://health-culture.org/sleep-advice/finish-work-earlier> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/slp-relax-before-bed/> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/evening> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/technology> ;
  hsa:problem <https://health-culture.org/sleep-advice/facet/problem/gaming-social-media> ;
  skos:definition "Avoid intense exercise, heavy discussions, or engaging TV shows at least 1 hour before bed. Instead, opt for calming activities like gentle stretching, journaling, or deep breathing exercises."@en ;
  skos:editorialNote "Overlaps 1.3.7 and 2.3.4. Write-up has no citations."@en .

<https://health-culture.org/sleep-advice/dont-check-the-clock> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "If you wake at night, don't look at the clock."@en ;
  hsa:kind "advice" ;
  skos:notation "1.3.4" ;
  skos:altLabel "Avoid checking the clock if you wake up at night"@en ;
  skos:altLabel "Don't Check the Clock"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/1.3> ;
  skos:related <https://health-culture.org/sleep-advice/get-up-if-you-cant-sleep> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/during-the-night> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/insomnia> ;
  skos:definition "Turn your clock away from your bed or use a non-illuminated alarm clock. If you wake up, focus on relaxing breathing exercises rather than checking the time."@en ;
  skos:editorialNote "NHLBI (p. 30) says to turn the clock face away. Write-up has no citations."@en .

