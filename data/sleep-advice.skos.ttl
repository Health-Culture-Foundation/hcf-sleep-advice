<https://health-culture.org/sleep-advice/caffeine-and-big-meals-early> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Have your last caffeine by early afternoon and your last big meal a few hours before bed."@en ;
  hsa:kind "advice" ;
  skos:notation "2.2.1" ;
  skos:altLabel "Avoid caffeine and heavy meals before bed"@en ;
  skos:altLabel "Avoid Caffeine and Nicotine Before Bed"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/2.2> ;
  skos:related <https://health-culture.org/sleep-advice/small-snack-before-bed> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/slp-avoid-caffeine-and-nicotine-before-bed/> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/slp-avoid-large-meals-and-fluids-late-at-night/> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/substances> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/digestion-and-fluids> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/afternoon> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/evening> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/reflux> ;
  skos:definition "Avoid caffeine at least 6 hours before bed and finish heavy meals 2–3 hours before sleeping. If hungry late at night, opt for a light snack like yogurt or a banana."@en ;
  skos:editorialNote "NHLBI pairs caffeine with nicotine; the wiki has no nicotine item. Wiki splits alcohol into 2.2.3."@en .

<https://health-culture.org/sleep-advice/drink-more-earlier-in-the-day> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Drink most of your fluids earlier in the day so you don't wake up to use the bathroom."@en ;
