  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/insomnia> ;
  skos:editorialNote "Better evidence (Cochrane 2022) than binaural beats, pink noise or ASMR."@en .

<https://health-culture.org/sleep-advice/myth-falling-asleep-anywhere> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Falling asleep anywhere, any time is a sign you're short on sleep, not a sign of good sleep."@en ;
  hsa:kind "myth" ;
  skos:related <https://health-culture.org/sleep-advice/get-enough-sleep-for-you> ;
