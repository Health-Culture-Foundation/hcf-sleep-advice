<https://health-culture.org/sleep-advice/screens-before-bed> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "In the hour before bed, choose calm screen use or none, and keep phones out of children's bedrooms."@en ;
  hsa:kind "advice" ;
  skos:notation "1.3.1" ;
  skos:altLabel "Avoid screens before bed"@en ;
  skos:altLabel "Screen curfew"@en ;
  skos:altLabel "No screens before bed"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/1.3> ;
  skos:related <https://health-culture.org/sleep-advice/keep-devices-out-of-the-bedroom> ;
  skos:related <https://health-culture.org/sleep-advice/myth-tv-helps-you-sleep> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/arousal> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/time-displacement> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/light-at-night> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/evening> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/bedtime> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  skos:definition "Set a “screen curfew” 30–60 minutes before bed and switch to audiobooks, reading, or relaxation exercises instead. If you must use a screen, enable night mode or blue light filters."@en ;
  skos:editorialNote "This is the worked example in the Open Health Communication Declaration (vivwebsolutions/hcf-guides#6). The plain line is a first try at the nuanced version and needs Kalman's review. Wiki tip: a 'screen curfew' 30-60 minutes before bed."@en .

<https://health-culture.org/sleep-advice/have-a-wind-down-routine> a skos:Concept ;
