<https://health-culture.org/sleep-advice/keep-a-regular-sleep-schedule> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "Go to bed and get up at about the same times every day."@en ;
  hsa:kind "advice" ;
  skos:notation "1.1.1" ;
  skos:altLabel "Maintain a consistent sleep schedule"@en ;
  skos:altLabel "Stick to a Sleep Schedule"@en ;
  skos:altLabel "Consistent sleep schedule"@en ;
  skos:altLabel "Sleep regularity"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/1.1> ;
  skos:related <https://health-culture.org/sleep-advice/fit-bedtime-to-your-body-clock> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/slp-stick-to-a-sleep-schedule/> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/sleep-hygiene/> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/body-clock> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/any-time> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/insomnia> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/late-body-clock> ;
  skos:definition "Set a regular bedtime and wake-up time, even on weekends. Use alarms or bedtime reminders to help stay consistent, and get morning sunlight to reinforce your body’s natural clock."@en .

<https://health-culture.org/sleep-advice/change-sleep-times-gradually> a skos:Concept ;
  skos:inScheme <https://health-culture.org/sleep-advice/> ;
  skos:prefLabel "If you need to move your sleep times, shift them a little each day instead of all at once."@en ;
  hsa:kind "advice" ;
  skos:notation "1.1.2" ;
  skos:altLabel "Avoid drastic changes in sleep and wake times"@en ;
  skos:broader <https://health-culture.org/sleep-advice/category/1.1> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/slp-stick-to-a-sleep-schedule/> ;
  skos:closeMatch <https://iha-health-glossary.pages.dev/terms/slp-coping-with-jet-lag/> ;
  hsa:mechanism <https://health-culture.org/sleep-advice/facet/mechanism/body-clock> ;
  hsa:timeOfDay <https://health-culture.org/sleep-advice/facet/timeOfDay/ahead-of-time> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/general> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/jet-lag> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/shift-work> ;
  hsa:condition <https://health-culture.org/sleep-advice/facet/condition/late-body-clock> ;
  skos:definition "Gradually adjust your sleep schedule by shifting your bedtime or wake-up time by 15–30 minutes per night instead of making sudden changes."@en ;
  skos:editorialNote "The wiki item title says 'avoid drastic changes'; its practical tip is about shifting 15-30 minutes per night, which is the actionable version used for the plain line."@en .

