{
  "_about": "Facets drafted by Claude on 2026-10-21, unreviewed. Each concept gets one or more values per facet. 'mechanism' is how the sources say the advice works, not a claim that it does. 'condition' says who the advice is especially relevant to; 'general' means anyone. Format per item: [mechanisms, times, conditions], each a '|'-separated list.",
  "facets": {
    "mechanism": {
      "label": "How it is said to work",
      "values": {
        "body-clock": {"label": "Body clock timing", "definition": "Sets or shifts the circadian clock: light at the right time, regular times, gradual shifts, melatonin timing."},
        "light-at-night": {"label": "Light at night", "definition": "Less light in the evening or at night, said to keep melatonin up and the brain less alert."},
        "sleep-pressure": {"label": "Sleep pressure", "definition": "Builds or protects the drive to sleep that grows the longer you are awake (naps, time in bed, activity)."},
        "body-temperature": {"label": "Body temperature", "definition": "Helps the core body temperature drop that comes with sleep (cool room, warm bath then cooling, warm feet)."},
        "arousal": {"label": "Calming body and mind", "definition": "Lowers mental, emotional or physical arousal: stress, racing thoughts, exciting content, hard exercise."},
        "learned-association": {"label": "Learned cues", "definition": "Trains the brain to link bed and bedtime routines with sleep, not with lying awake."},
        "substances": {"label": "Substances", "definition": "Caffeine, alcohol, nicotine, supplements, herbal products, medicines."},
        "digestion-and-fluids": {"label": "Food, drink and digestion", "definition": "Meal timing and size, reflux, night-time bathroom trips."},
        "sleep-environment": {"label": "Bedroom environment", "definition": "Noise, comfort, tidiness, scent: the room itself."},
        "breathing-and-airway": {"label": "Breathing and airway", "definition": "Keeping the airway open at night; snoring and sleep apnea."},
        "time-displacement": {"label": "Time taken from sleep", "definition": "An activity that pushes bedtime later or eats into sleep time (e.g. screens, per Bauducco et al. 2024)."},
        "monitoring-and-care": {"label": "Tracking and getting care", "definition": "Noticing patterns or problems and getting them checked: sleep diaries, medicine reviews, testing for apnea."}
      }
    },
    "timeOfDay": {
      "label": "When you do it",
      "values": {
        "on-waking": {"label": "On waking / morning"},
        "daytime": {"label": "During the day"},
        "afternoon": {"label": "Afternoon"},
        "evening": {"label": "Evening, the hours before bed"},
        "bedtime": {"label": "At bedtime, in bed"},
        "during-the-night": {"label": "During the night, if you wake"},
        "any-time": {"label": "Any time: a habit or a one-off setup"},
